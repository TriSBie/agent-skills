{
  "$description": "interactive-learning-sim tokens (W3C Design Tokens format). Mirrors assets/starter-vanilla-vite/src/styles/main.css; names map as bg-app=--paper, bg-panel=--card, bg-2=--sheet, bg-3=--card-2, ink-3=--muted, accent=--rust (warning/accent text). ink-4 (--muted-2) is decoration only, never text.",
  "color": {
    "$type": "color",
    "dark": {
      "bg-app": { "$value": "#1a1c1f" },
      "bg-panel": { "$value": "#202226" },
      "bg-2": { "$value": "#222428" },
      "bg-3": { "$value": "#1b1d20" },
      "line": { "$value": "#2f3237" },
      "line-2": { "$value": "#464a50" },
      "edge": { "$value": "#c2bfb9" },
      "ink": { "$value": "#ece8e1" },
      "ink-2": { "$value": "#d3cfc7" },
      "ink-3": { "$value": "#a6a29b" },
      "ink-4": { "$value": "#8a867f" }
    },
    "light": {
      "bg-app": { "$value": "#f2eee5" },
      "bg-panel": { "$value": "#f6f2ea" },
      "bg-2": { "$value": "#f8f5ef" },
      "bg-3": { "$value": "#eee8dc" },
      "line": { "$value": "#d8d2c6" },
      "line-2": { "$value": "#bfb8ab" },
      "edge": { "$value": "#3a3f46" },
      "ink": { "$value": "#1f2328" },
      "ink-2": { "$value": "#383d44" },
      "ink-3": { "$value": "#5b6068" },
      "ink-4": { "$value": "#80858c" }
    },
    "accent": { "$value": "#a5461b", "$description": "Light-theme --rust. Used as text on paper and as a fill under accent-ink." },
    "accent-ink": { "$value": "#ffffff" },
    "packet": {
      "req": { "$value": "#2b7bbf" },
      "res": { "$value": "#2d8a4e" },
      "write": { "$value": "#6d5ac8" },
      "slow": { "$value": "#c7761f" },
      "drop": { "$value": "#c0392f" }
    }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": "12px" },
    "sm": { "$value": "8px" }
  }
}
