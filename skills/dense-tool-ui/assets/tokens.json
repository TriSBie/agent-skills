{
  "$description": "dense-tool-ui design system v1 (W3C Design Tokens format). Hex values are the sRGB render of the LCH values in app-template.html. ink-4 is for decoration only (dots, strokes, disabled), never text.",
  "color": {
    "$type": "color",
    "dark": {
      "bg-app": { "$value": "#09090a" },
      "bg-panel": { "$value": "#121213" },
      "bg-2": { "$value": "#1a1a1b" },
      "bg-3": { "$value": "#212122" },
      "bg-ctl": { "$value": "#2a2b2d" },
      "bg-hover": { "$value": "#29292b" },
      "line": { "$value": "#1a1b1d" },
      "line-2": { "$value": "#232426" },
      "line-3": { "$value": "#323336" },
      "ink": { "$value": "#ffffff" },
      "ink-2": { "$value": "#e3e4e6" },
      "ink-3": { "$value": "#959597" },
      "ink-4": { "$value": "#565759" }
    },
    "light": {
      "bg-app": { "$value": "#efeff0" },
      "bg-panel": { "$value": "#fcfcfd" },
      "bg-2": { "$value": "#ffffff" },
      "bg-3": { "$value": "#ffffff" },
      "bg-ctl": { "$value": "#ececee" },
      "bg-hover": { "$value": "#e6e6e9" },
      "line": { "$value": "#e2e2e2" },
      "line-2": { "$value": "#dcdbdd" },
      "line-3": { "$value": "#d0d0d4" },
      "ink": { "$value": "#1b1c20" },
      "ink-2": { "$value": "#3c4149" },
      "ink-3": { "$value": "#66656e" },
      "ink-4": { "$value": "#a3a2aa" }
    },
    "accent": { "$value": "#0075c5", "$description": "lch(44 59 250). Change the hue; keep L<=44 so accent-ink on it stays >= 4.5:1." },
    "accent-ink": { "$value": "#f8ffff" }
  },
  "dimension": {
    "$type": "dimension",
    "sidebar": { "$value": "244px" },
    "header": { "$value": "52px" },
    "row": { "$value": "44px" },
    "control": { "$value": "28px" }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "8px" },
    "panel": { "$value": "12px" },
    "modal": { "$value": "16px" },
    "pill": { "$value": "9999px" }
  },
  "font-size": {
    "$type": "dimension",
    "meta": { "$value": "12px" },
    "body": { "$value": "13px" },
    "editor": { "$value": "15px" },
    "modal-title": { "$value": "18px" },
    "h1": { "$value": "24px" }
  },
  "easing": { "$type": "cubicBezier", "out": { "$value": [0.23, 1, 0.32, 1] } }
}
